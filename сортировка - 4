#include <iostream>
using namespace std;

int bubble_sort(int arr[], int n) {
    int k = 0;                              
    for (int iter = 0; iter < n - 1; iter++) {
        bool swapped = false;          
        for (int i = 0; i < n - iter - 1; i++) {
            if (arr[i] > arr[i + 1]) {      
                swap(arr[i], arr[i + 1]);   
                k++;                        
                swapped = true;
            }
        }
        if (!swapped) break;                
    }
    return k;
}

int main() {
    int n;
    cin >> n;                               

    int arr[1000];                          
    for (int i = 0; i < n; i++) {
        cin >> arr[i];                     
    }

    cout << bubble_sort(arr, n) << endl;   
    return 0;
}
