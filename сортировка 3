#include <iostream>
#include <vector>
using namespace std;

void bubble_sort(vector<int>& arr) {
    int n = arr.size();

    for (int iter = 0; iter < n - 1; iter++) {
        bool swapped = false;

        for (int i = 0; i < n - iter - 1; i++) {
            if (arr[i] < arr[i + 1]) {
                swap(arr[i], arr[i + 1]);
                swapped = true;
            }
        }

        if (!swapped) {
            break;
        }
    }
}

int main() {
    vector<int> arr;
    int x;

    while (cin >> x) {
        arr.push_back(x);

        if (cin.peek() == '\n') {
            break;
        }
    }

    bubble_sort(arr);

    for (int i = 0; i < arr.size(); i++) {
        if (i > 0) cout << " ";
        cout << arr[i];
    }

    cout << endl;

    return 0;
}
